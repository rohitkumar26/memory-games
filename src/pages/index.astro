---
import GameShell from '../layouts/GameShell.astro';

// Auto-discover all games
const gameModules = import.meta.glob('../games/*/manifest.json', { eager: true });

const games = Object.entries(gameModules).map(([path, mod]) => {
  const manifest = (mod as any).default;
  return {
    ...manifest,
    path: path.replace('../games/', '').replace('/manifest.json', '')
  };
});

const categoryColors: Record<string, string> = {
  'visual-spatial': 'from-pink-400 to-rose-400',
  'sequence-recall': 'from-blue-400 to-cyan-400',
  'pattern-completion': 'from-green-400 to-emerald-400',
  'category-sorting': 'from-yellow-400 to-orange-400',
  'object-recall': 'from-purple-400 to-violet-400',
  'drawing-tracing': 'from-amber-400 to-orange-400',
};

const categoryLabels: Record<string, string> = {
  'visual-spatial': '🧩 Visual-Spatial',
  'sequence-recall': '🎵 Sequence Recall',
  'pattern-completion': '✨ Pattern Completion',
  'category-sorting': '📊 Category Sorting',
  'object-recall': '👁️ Object Recall',
  'drawing-tracing': '✏️ Drawing & Tracing',
};

const gameIcons: Record<string, string> = {
  'memory-match': '🧠',
  'simon-says': '🚦',
  'shadow-matching': '🌓',
  'category-sorting': '🧺',
  'trace-the-path': '✏️',
  'whats-missing': '🕵️',
  'spot-the-difference': '🔍',
  'connect-the-dots': '🔢',
  'number-sequence': '🎯',
  'habitat-sort': '🌴',
};

const categories = [
  { id: 'all', name: 'All Games', icon: '🌟', desc: 'Explore all fun memory and learning games' },
  { id: 'visual-spatial', name: 'Visual-Spatial', icon: '🧩', desc: 'Card matching, shadow identification, & visual scanning' },
  { id: 'sequence-recall', name: 'Sequence Recall', icon: '🎵', desc: 'Audio-visual patterns, rhythm, & number sequences' },
  { id: 'category-sorting', name: 'Category Sorting', icon: '📊', desc: 'Habitat classification, food & object sorting' },
  { id: 'object-recall', name: 'Object Recall', icon: '👁️', desc: 'Short-term tray memory & missing object detection' },
  { id: 'drawing-tracing', name: 'Drawing & Tracing', icon: '✏️', desc: 'Fine motor control, dotted lines & connect-the-dots' },
];
---

<GameShell title="🧠 Kids Memory Games — Fun & Free!">
  <div class="min-h-screen flex flex-col md:flex-row">
    <!-- Desktop & Tablet Sidebar -->
    <aside class="w-full md:w-72 lg:w-80 bg-white/90 backdrop-blur-md border-r border-purple-100 p-6 flex flex-col justify-between shrink-0 shadow-sm">
      <div class="flex flex-col gap-6">
        <!-- Logo Branding -->
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-kid-purple to-kid-pink flex items-center justify-center text-2xl shadow-md">
            🧠
          </div>
          <div>
            <h1 class="text-xl font-black text-gray-800 leading-tight">Memory Games</h1>
            <p class="text-xs font-bold text-kid-purple">Kids Learning Arcade</p>
          </div>
        </div>

        <!-- Category Navigation -->
        <nav class="flex flex-col gap-1.5" aria-label="Game Categories">
          <span class="text-[11px] font-black uppercase tracking-wider text-gray-400 px-3">
            Categories
          </span>

          {categories.map((cat) => {
            const count = cat.id === 'all' ? games.length : games.filter(g => g.category === cat.id).length;
            return (
              <button
                class={`sidebar-cat-btn w-full px-4 py-3 rounded-2xl font-black text-sm transition-all duration-200 cursor-pointer flex items-center justify-between text-left ${
                  cat.id === 'all'
                    ? 'bg-gradient-to-r from-kid-purple to-kid-pink text-white shadow-md active'
                    : 'bg-transparent text-gray-600 hover:bg-purple-50 hover:text-kid-purple'
                }`}
                data-category={cat.id}
                data-desc={cat.desc}
              >
                <div class="flex items-center gap-3">
                  <span class="text-xl">{cat.icon}</span>
                  <span>{cat.name}</span>
                </div>
                <span class={`cat-badge px-2.5 py-0.5 rounded-full text-xs font-bold ${
                  cat.id === 'all' ? 'bg-white/30 text-white' : 'bg-gray-100 text-gray-500'
                }`}>
                  {count}
                </span>
              </button>
            );
          })}
        </nav>
      </div>

      <!-- Sidebar Bottom Controls -->
      <div class="mt-8 pt-6 border-t border-gray-100 flex flex-col gap-4">
        <!-- Sound Toggle -->
        <button
          id="home-sound-btn"
          class="w-full px-4 py-3 bg-purple-50 hover:bg-purple-100 text-purple-700 rounded-2xl text-sm font-bold shadow-sm transition-all active:scale-95 cursor-pointer flex items-center justify-between"
          title="Toggle Sound Effects"
        >
          <div class="flex items-center gap-2.5">
            <span id="home-sound-icon" class="text-xl">🔊</span>
            <span>Game Sound</span>
          </div>
          <span class="text-xs px-2 py-0.5 bg-purple-200/60 rounded-full font-bold">On / Off</span>
        </button>

        <!-- Trust Badges -->
        <div class="p-3 bg-gradient-to-br from-emerald-50 to-teal-50 rounded-2xl border border-emerald-100">
          <div class="flex items-center gap-2 text-emerald-800 font-bold text-xs mb-1">
            <span>🔒</span>
            <span>100% Kid Safe & COPPA Compliant</span>
          </div>
          <p class="text-[11px] text-emerald-700/80 leading-relaxed">
            Zero ads, zero trackers, pure learning fun.
          </p>
        </div>
      </div>
    </aside>

    <!-- Main Content Area -->
    <main class="flex-1 p-6 md:p-10 flex flex-col max-w-6xl mx-auto w-full">
      <!-- Top Title Header -->
      <header class="mb-8">
        <div class="flex items-center gap-2 mb-2">
          <span id="header-category-icon" class="text-3xl">🌟</span>
          <h2 id="header-category-title" class="text-3xl sm:text-4xl font-black text-gray-800">
            All Games
          </h2>
        </div>
        <p id="header-category-desc" class="text-gray-500 text-base">
          Explore all fun memory, visual tracking, and sequence games! Click any difficulty star on a card to start directly.
        </p>
      </header>

      <!-- Games Grid -->
      <div id="games-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {games.map((game) => (
          <div 
            data-category={game.category}
            data-game-id={game.id}
            data-default-level={game.difficulty.default || 1}
            data-selected-level={game.difficulty.default || 1}
            class="game-card group relative bg-white rounded-3xl p-6 shadow-md hover:shadow-2xl transition-all duration-300 border-4 border-transparent hover:border-kid-purple/30 flex flex-col justify-between cursor-pointer"
          >
            <!-- Category Gradient Bar -->
            <div class={`absolute top-0 left-0 right-0 h-2.5 bg-gradient-to-r ${categoryColors[game.category] || 'from-gray-400 to-gray-500'} rounded-t-3xl`} />

            <!-- Card Header & Body Link -->
            <a href={`/play/${game.id}`} class="card-body-link block cursor-pointer text-left focus:outline-none">
              <!-- Card Header -->
              <div class="flex items-start justify-between mb-3 mt-1">
                <span class="text-4xl group-hover:scale-110 transition-transform">{gameIcons[game.id] || '🎮'}</span>
                <div class="flex flex-col items-end gap-1">
                  <span class="px-3 py-1 bg-gray-100 rounded-full text-xs font-bold text-gray-500">
                    Ages {game.ageRange.min}-{game.ageRange.max}
                  </span>
                  <span class="px-2.5 py-0.5 bg-purple-50 text-purple-600 rounded-full text-[11px] font-bold">
                    {categoryLabels[game.category] || game.category}
                  </span>
                </div>
              </div>

              <!-- Game Title & Desc -->
              <h3 class="text-2xl font-black text-gray-800 mb-2 group-hover:text-kid-purple transition-colors">
                {game.name}
              </h3>

              <p class="text-gray-500 text-sm mb-4 line-clamp-2 leading-relaxed">
                {game.description}
              </p>
            </a>

            <!-- Card Bottom: Interactive Difficulty Stars + Play Button -->
            <div class="mt-4 pt-4 border-t border-gray-100 flex flex-col gap-3">
              <!-- Interactive Stars Selector -->
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-gray-400 uppercase tracking-wider">
                  Difficulty
                </span>

                <div class="diff-stars-container flex items-center gap-1 bg-amber-50/80 px-2 py-1 rounded-xl border border-amber-100" data-game-id={game.id}>
                  {[1, 2, 3, 4, 5].map((starNum) => (
                    <button
                      type="button"
                      class={`star-btn text-lg transition-transform hover:scale-130 active:scale-95 cursor-pointer select-none ${
                        starNum <= (game.difficulty.default || 1) ? 'opacity-100 scale-105' : 'opacity-25 grayscale'
                      }`}
                      data-star-level={starNum}
                      title={`Select Difficulty Level ${starNum}`}
                      aria-label={`Difficulty ${starNum}`}
                    >
                      ⭐
                    </button>
                  ))}
                </div>
              </div>

              <!-- Direct Start Play Button -->
              <a 
                href={`/play/${game.id}?difficulty=${game.difficulty.default || 1}&start=true`}
                class="play-game-btn w-full py-3 bg-gradient-to-r from-kid-purple to-kid-pink text-white rounded-2xl font-black text-center text-sm shadow-md hover:shadow-lg hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center justify-center gap-2 cursor-pointer"
              >
                <span>Play Level <span class="selected-level-text">{game.difficulty.default || 1}</span></span>
                <span>→</span>
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- Empty State for categories with 0 games yet -->
      <div id="no-games-msg" class="hidden text-center py-16 px-6 bg-white/70 backdrop-blur rounded-3xl max-w-md mx-auto border-3 border-dashed border-purple-200 shadow-sm mt-8">
        <div class="text-5xl mb-3 animate-bounce-slow">🚀</div>
        <h3 class="text-xl font-black text-gray-700 mb-1">Coming Next!</h3>
        <p class="text-sm text-gray-500">We are currently crafting brand new games for this category.</p>
      </div>

      <!-- Footer -->
      <footer class="mt-16 text-center text-gray-400 text-xs">
        <p>Made with 💜 for kids everywhere. No ads. No tracking. Just pure learning & fun.</p>
      </footer>
    </main>
  </div>

  <script>
    import { globalAudio } from '../core/audio';

    // Sound toggle
    const soundBtn = document.getElementById('home-sound-btn');
    const soundIcon = document.getElementById('home-sound-icon');

    const updateSoundIcon = () => {
      if (soundIcon) {
        soundIcon.textContent = globalAudio.isAudioMuted() ? '🔇' : '🔊';
      }
    };

    updateSoundIcon();

    soundBtn?.addEventListener('click', () => {
      globalAudio.unlock();
      globalAudio.toggleMute();
      updateSoundIcon();
    });

    window.addEventListener('audiomutestatuschange', updateSoundIcon);

    // Sidebar Category Filtering
    const sidebarButtons = document.querySelectorAll('.sidebar-cat-btn');
    const gameCards = document.querySelectorAll('.game-card');
    const noGamesMsg = document.getElementById('no-games-msg');
    const headerTitle = document.getElementById('header-category-title');
    const headerIcon = document.getElementById('header-category-icon');
    const headerDesc = document.getElementById('header-category-desc');

    sidebarButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-category');
        const desc = btn.getAttribute('data-desc');
        const icon = btn.querySelector('.text-xl')?.textContent || '🌟';
        const name = btn.querySelector('span:nth-child(2)')?.textContent || 'All Games';

        sidebarButtons.forEach((b) => {
          b.classList.remove('bg-gradient-to-r', 'from-kid-purple', 'to-kid-pink', 'text-white', 'shadow-md', 'active');
          b.classList.add('bg-transparent', 'text-gray-600');
          const badge = b.querySelector('.cat-badge');
          if (badge) {
            badge.className = 'cat-badge px-2.5 py-0.5 rounded-full text-xs font-bold bg-gray-100 text-gray-500';
          }
        });

        btn.classList.add('bg-gradient-to-r', 'from-kid-purple', 'to-kid-pink', 'text-white', 'shadow-md', 'active');
        btn.classList.remove('bg-transparent', 'text-gray-600');
        const badge = btn.querySelector('.cat-badge');
        if (badge) {
          badge.className = 'cat-badge px-2.5 py-0.5 rounded-full text-xs font-bold bg-white/30 text-white';
        }

        // Update header banner
        if (headerTitle) headerTitle.textContent = name;
        if (headerIcon) headerIcon.textContent = icon;
        if (headerDesc && desc) headerDesc.textContent = desc;

        let visibleCount = 0;
        gameCards.forEach((card) => {
          const cardCat = card.getAttribute('data-category');
          if (cat === 'all' || cardCat === cat) {
            (card as HTMLElement).style.display = 'flex';
            visibleCount++;
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });

        if (noGamesMsg) {
          if (visibleCount === 0) {
            noGamesMsg.classList.remove('hidden');
          } else {
            noGamesMsg.classList.add('hidden');
          }
        }
      });
    });

    // Interactive Difficulty Stars on Game Cards
    gameCards.forEach((card) => {
      const gameId = card.getAttribute('data-game-id');
      const starButtons = card.querySelectorAll('.star-btn');
      const playBtn = card.querySelector('.play-game-btn');
      const levelText = card.querySelector('.selected-level-text');
      // Clicking anywhere on the card (except star buttons or play button) opens game home page
      card.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.closest('.diff-stars-container') || target.closest('.play-game-btn') || target.closest('.card-body-link')) {
          return;
        }
        if (gameId) {
          window.location.href = `/play/${gameId}`;
        }
      });

      starButtons.forEach((starBtn) => {
        starBtn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();

          const selectedLevel = parseInt(starBtn.getAttribute('data-star-level') || '1', 10);
          globalAudio.play('click');

          // Highlight stars up to selected level
          starButtons.forEach((s) => {
            const sLevel = parseInt(s.getAttribute('data-star-level') || '1', 10);
            if (sLevel <= selectedLevel) {
              s.classList.remove('opacity-25', 'grayscale');
              s.classList.add('opacity-100', 'scale-110');
            } else {
              s.classList.remove('opacity-100', 'scale-110');
              s.classList.add('opacity-25', 'grayscale');
            }
          });

          // Update Card Play Button URL & Text
          card.setAttribute('data-selected-level', String(selectedLevel));
          if (levelText) {
            levelText.textContent = String(selectedLevel);
          }
          if (playBtn && gameId) {
            playBtn.setAttribute('href', `/play/${gameId}?difficulty=${selectedLevel}&start=true`);
          }
        });
      });
    });
  </script>
</GameShell>
