---
import GameShell from '../layouts/GameShell.astro';

const scormBenefits = [
  {
    icon: '📊',
    title: 'Instant LMS Gradebook Sync',
    desc: 'SCORM 1.2 & 2004 compatible. Scores, completion percentage, and time spent automatically populate your Canvas, Moodle, Blackboard, or Schoology gradebook.'
  },
  {
    icon: '🛡️',
    title: '100% Ad-Free & COPPA/FERPA Safe',
    desc: 'Zero advertisements, zero third-party tracking scripts, and zero student data collection. Student records stay safely contained within your school LMS.'
  },
  {
    icon: '🔒',
    title: 'Firewall & Offline Ready',
    desc: 'Each SCORM package is a 100% self-contained zip file that runs directly on your school intranet without external network requests or domain blocking.'
  },
  {
    icon: '🏆',
    title: 'All 5 Difficulty Levels & Themes',
    desc: 'Unlock all 5 difficulty tiers (Starter to Master) plus all thematic variations, allowing perfect differentiation for diverse classroom learning levels.'
  },
  {
    icon: '📄',
    title: 'Curriculum & Objective Guides',
    desc: 'Includes printable Teacher PDF guides with cognitive skill alignments, Common Core connections, and 1-click LMS setup instructions.'
  },
  {
    icon: '🏫',
    title: 'Single-Sign-On Convenience',
    desc: 'Students click directly inside their normal daily LMS assignments — no separate student logins, passwords, or registration required.'
  }
];

const lmsPlatforms = [
  { name: 'Canvas LMS', icon: '🔴', status: 'Verified 100%' },
  { name: 'Moodle', icon: '🟠', status: 'Verified 100%' },
  { name: 'Google Classroom', icon: '🟢', status: 'SCORM Player Ready' },
  { name: 'Schoology', icon: '🔵', status: 'Verified 100%' },
  { name: 'Blackboard Learn', icon: '⚫', status: 'Verified 100%' },
  { name: 'D2L Brightspace', icon: '🟣', status: 'Verified 100%' }
];

const pricingTiers = [
  {
    id: 'single',
    badge: 'Individual Game',
    name: 'Single SCORM Game',
    price: '$9',
    period: 'one-time payment',
    desc: 'Perfect for targeting a specific classroom lesson or cognitive skill.',
    features: [
      '1 Standalone SCORM 1.2 / 2004 .zip file',
      'All 5 Difficulty Levels unlocked',
      'All seasonal themes included',
      'Auto-Gradebook score reporting',
      'Teacher Quick-Start Guide (PDF)',
      'Lifetime updates for that game'
    ],
    ctaText: 'Choose a Game ($9)',
    ctaLink: 'https://payhip.com',
    popular: false
  },
  {
    id: 'bundle',
    badge: '⭐ Most Popular for Teachers',
    name: '10-Game Elementary Pack',
    price: '$49',
    period: 'one-time payment',
    desc: 'Complete cognitive memory curriculum covering all 5 brain development pillars.',
    features: [
      '10 Premium SCORM .zip packages',
      'Visual, Sequence, Sorting, Recall & Tracing',
      'All 5 Difficulty tiers per game (50 levels)',
      'Complete Curriculum Mapping Guide (PDF)',
      'Canvas & Moodle 1-Click Import Guide',
      'Email priority teacher support',
      'Lifetime classroom license'
    ],
    ctaText: 'Get 10-Game Pack ($49)',
    ctaLink: 'https://payhip.com',
    popular: true
  },
  {
    id: 'school',
    badge: 'District & School-Wide',
    name: 'All-Access School License',
    price: '$199',
    period: 'per year / school',
    desc: 'Unlimited access for all teachers and students in your entire elementary school.',
    features: [
      'All current (15+) + future (50) games',
      'Unlimited teachers & students in school',
      'Custom school logo / white-labeling',
      'Purchase Order (PO) & Invoice invoicing',
      'Dedicated educator support channel',
      'Custom game & curriculum requests'
    ],
    ctaText: 'Get School License ($199/yr)',
    ctaLink: '/contact?subject=School%20License%20Inquiry',
    popular: false
  }
];

const faqs = [
  {
    q: 'How do I upload these games to Canvas or Moodle?',
    a: 'In Canvas: Go to your Course → Modules → Add Item → SCORM → Upload your purchased .zip file. In Moodle: Add an Activity → SCORM package → Drag and drop the .zip file. The game is instantly playable and linked to your gradebook!'
  },
  {
    q: 'Do students need separate login accounts?',
    a: 'No! Students launch the games directly within Canvas, Moodle, or Schoology using their existing school student accounts. No new usernames or passwords are required.'
  },
  {
    q: 'Are these games compliant with COPPA and FERPA?',
    a: '100% yes. The games do not connect to external servers, do not contain third-party cookies or advertising, and store student performance records solely within your school’s secure LMS.'
  },
  {
    q: 'Can we pay via School Purchase Order (PO) or Check?',
    a: 'Yes! We accept School Purchase Orders, Credit Cards, PayPal, and Bank Transfers. Please reach out via our contact page with your school district details.'
  }
];
---

<GameShell title="🎓 SCORM Packages for Teachers & Schools — Kids Memory Games">
  <div class="max-w-6xl mx-auto px-4 py-8 sm:py-12">
    
    <!-- Hero Banner -->
    <div class="text-center max-w-3xl mx-auto mb-14">
      <span class="px-4 py-1.5 bg-purple-100 text-purple-700 rounded-full font-bold text-sm uppercase tracking-wider inline-block mb-4">
        🏫 Educator & LMS Curriculum Edition
      </span>
      <h1 class="text-4xl sm:text-6xl font-black text-gray-900 leading-tight mb-6">
        Ad-Free Interactive <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-600 to-pink-500">SCORM Games</span> for Your Classroom
      </h1>
      <p class="text-lg sm:text-xl text-gray-600 leading-relaxed mb-8">
        Plug high-retention cognitive memory games directly into <strong>Canvas, Moodle, Blackboard, Google Classroom, and Schoology</strong>. Automatic gradebook sync, all 5 difficulty levels, and 100% offline compliance.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="#pricing" class="px-8 py-4 bg-gradient-to-r from-purple-600 to-indigo-600 text-white font-extrabold text-lg rounded-2xl shadow-xl hover:scale-105 active:scale-95 transition-all">
          ✨ View Classroom Packs & Pricing
        </a>
        <a href="/" class="px-8 py-4 bg-white text-gray-700 font-extrabold text-lg rounded-2xl border-2 border-gray-200 hover:border-purple-300 shadow-md hover:scale-105 active:scale-95 transition-all">
          🎮 Try Free Web Demos
        </a>
      </div>
    </div>

    <!-- Supported LMS Badges -->
    <div class="bg-purple-50/70 border-2 border-purple-100 rounded-3xl p-6 sm:p-8 mb-16 text-center">
      <span class="text-xs font-black text-purple-800 uppercase tracking-widest block mb-4">Compatible With All Major Learning Management Systems</span>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-4">
        {lmsPlatforms.map(lms => (
          <div class="bg-white rounded-2xl p-4 shadow-sm border border-purple-100 flex flex-col items-center gap-1">
            <span class="text-3xl">{lms.icon}</span>
            <span class="font-bold text-gray-800 text-sm">{lms.name}</span>
            <span class="text-2xs font-bold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full">{lms.status}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Why SCORM Section -->
    <div class="mb-16">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h2 class="text-3xl sm:text-4xl font-black text-gray-900 mb-3">Why Educators Choose SCORM Packages</h2>
        <p class="text-gray-600">Transform casual web games into accountable, graded digital classroom learning activities.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {scormBenefits.map(b => (
          <div class="bg-white rounded-3xl p-6 shadow-md border-2 border-gray-100 hover:border-purple-300 transition-all flex flex-col gap-3">
            <span class="text-4xl">{b.icon}</span>
            <h3 class="text-xl font-bold text-gray-900">{b.title}</h3>
            <p class="text-gray-600 text-sm leading-relaxed">{b.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Free Web vs SCORM Comparison Table -->
    <div class="bg-white rounded-3xl p-6 sm:p-10 shadow-xl border-2 border-gray-100 mb-16">
      <div class="text-center max-w-2xl mx-auto mb-8">
        <h2 class="text-3xl font-black text-gray-900 mb-2">Free Web vs. Classroom SCORM Edition</h2>
        <p class="text-gray-600 text-sm">Choose the right solution for your home or school environment.</p>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="border-b-2 border-gray-200">
              <th class="py-4 px-4 font-black text-gray-900 text-base">Feature</th>
              <th class="py-4 px-4 font-bold text-gray-600 text-center">🌐 Free Website</th>
              <th class="py-4 px-4 font-black text-purple-700 bg-purple-50 text-center rounded-t-2xl">📦 Classroom SCORM Package</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <tr>
              <td class="py-4 px-4 font-bold text-gray-800">LMS Gradebook Integration</td>
              <td class="py-4 px-4 text-center text-gray-400">❌ No (Local only)</td>
              <td class="py-4 px-4 text-center text-emerald-600 font-bold bg-purple-50">✅ Automatic (SCORM 1.2 / 2004)</td>
            </tr>
            <tr>
              <td class="py-4 px-4 font-bold text-gray-800">Difficulty Levels Available</td>
              <td class="py-4 px-4 text-center text-gray-600">Levels 1 to 3</td>
              <td class="py-4 px-4 text-center text-purple-700 font-bold bg-purple-50">🌟 All 5 Levels (Starter to Master)</td>
            </tr>
            <tr>
              <td class="py-4 px-4 font-bold text-gray-800">Student Progress Tracking</td>
              <td class="py-4 px-4 text-center text-gray-400">❌ None</td>
              <td class="py-4 px-4 text-center text-emerald-600 font-bold bg-purple-50">✅ Full Teacher Dashboard Sync</td>
            </tr>
            <tr>
              <td class="py-4 px-4 font-bold text-gray-800">Internet / Network Requirement</td>
              <td class="py-4 px-4 text-center text-gray-600">Online Browser required</td>
              <td class="py-4 px-4 text-center text-purple-700 font-bold bg-purple-50">🔒 100% Offline Standalone Zip</td>
            </tr>
            <tr>
              <td class="py-4 px-4 font-bold text-gray-800">Distraction-Free Environment</td>
              <td class="py-4 px-4 text-center text-gray-600">Public web layout</td>
              <td class="py-4 px-4 text-center text-emerald-600 font-bold bg-purple-50">✨ Zero External Links & Ads</td>
            </tr>
            <tr>
              <td class="py-4 px-4 font-bold text-gray-800">Printable Teacher Guides</td>
              <td class="py-4 px-4 text-center text-gray-400">Basic Web text</td>
              <td class="py-4 px-4 text-center text-purple-700 font-bold bg-purple-50">📄 Complete PDF Curriculum Sheets</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Pricing Tiers -->
    <div id="pricing" class="mb-16">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="px-4 py-1 bg-emerald-100 text-emerald-700 rounded-full font-bold text-xs uppercase tracking-wider inline-block mb-3">
          Instant Delivery via Payhip & Purchase Orders
        </span>
        <h2 class="text-3xl sm:text-4xl font-black text-gray-900 mb-3">Simple, Transparent Classroom Pricing</h2>
        <p class="text-gray-600">One-time payments with zero monthly fees. No recurring student seat charges.</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
        {pricingTiers.map(tier => (
          <div class={`bg-white rounded-3xl p-8 shadow-xl flex flex-col justify-between relative border-3 ${tier.popular ? 'border-purple-500 ring-4 ring-purple-100 scale-105' : 'border-gray-200'}`}>
            {tier.popular && (
              <span class="absolute -top-4 left-1/2 -translate-x-1/2 px-4 py-1 bg-purple-600 text-white font-extrabold text-xs rounded-full uppercase tracking-wider shadow-md">
                ⭐ Most Popular
              </span>
            )}
            <div>
              <span class="text-xs font-black text-gray-400 uppercase tracking-widest block mb-2">{tier.badge}</span>
              <h3 class="text-2xl font-black text-gray-900 mb-2">{tier.name}</h3>
              <div class="flex items-baseline gap-2 mb-4">
                <span class="text-5xl font-black text-gray-900">{tier.price}</span>
                <span class="text-sm font-bold text-gray-500">{tier.period}</span>
              </div>
              <p class="text-gray-600 text-sm mb-6 leading-relaxed">{tier.desc}</p>
              
              <ul class="space-y-3 mb-8">
                {tier.features.map(f => (
                  <li class="flex items-start gap-2 text-sm text-gray-700 font-medium">
                    <span class="text-emerald-500 font-bold">✓</span>
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
            </div>

            <a
              href={tier.ctaLink}
              class={`w-full py-4 rounded-2xl font-black text-center text-base transition-all shadow-lg hover:scale-105 active:scale-95 ${tier.popular ? 'bg-gradient-to-r from-purple-600 to-pink-500 text-white' : 'bg-gray-900 text-white hover:bg-purple-600'}`}
            >
              {tier.ctaText}
            </a>
          </div>
        ))}
      </div>
    </div>

    <!-- FAQ Section -->
    <div class="bg-gray-50 rounded-3xl p-8 sm:p-12 mb-16 border-2 border-gray-100">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h2 class="text-3xl font-black text-gray-900 mb-2">Frequently Asked Questions</h2>
        <p class="text-gray-600 text-sm">Everything you need to know about setting up SCORM packages in your school.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        {faqs.map(faq => (
          <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-200">
            <h3 class="font-black text-gray-900 text-base mb-2">❓ {faq.q}</h3>
            <p class="text-gray-600 text-sm leading-relaxed">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Bottom Purchase Order & Invoicing CTA -->
    <div class="bg-gradient-to-r from-purple-700 via-indigo-700 to-purple-800 rounded-3xl p-8 sm:p-12 text-white text-center shadow-2xl">
      <span class="text-5xl block mb-4">🏫</span>
      <h2 class="text-3xl sm:text-4xl font-black mb-4">Need a School District Quote or Custom PO?</h2>
      <p class="text-purple-200 max-w-2xl mx-auto text-base sm:text-lg mb-8">
        We gladly work with school district purchase orders, educational procurement departments, and grant programs worldwide.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="/contact?subject=District%20Quote%20Request" class="px-8 py-4 bg-white text-purple-900 font-extrabold text-base rounded-2xl shadow-xl hover:scale-105 active:scale-95 transition-all">
          📝 Request Official Quote / Invoice
        </a>
        <a href="mailto:support@kidsmemorygames.com" class="px-8 py-4 bg-purple-600/50 backdrop-blur text-white font-extrabold text-base rounded-2xl border border-white/20 hover:bg-purple-600 transition-all">
          📧 Email Educational Support
        </a>
      </div>
    </div>

  </div>
</GameShell>
