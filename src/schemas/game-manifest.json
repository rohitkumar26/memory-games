{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kids-memory-games.pages.dev/schemas/game-manifest.json",
  "title": "Kids Memory Game Manifest Schema",
  "description": "Validation schema for educational kids memory arcade games manifests",
  "type": "object",
  "required": [
    "id",
    "name",
    "description",
    "version",
    "engine",
    "category",
    "difficulty",
    "ageRange"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "URI reference to this schema definition"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Unique kebab-case identifier for the game module"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60,
      "description": "Human-readable educational game title"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 300,
      "description": "Short pedagogical summary and objective of the game"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "SemVer version of the game"
    },
    "engine": {
      "type": "string",
      "enum": [
        "dom-engine",
        "canvas-engine",
        "phaser-engine"
      ],
      "description": "Core rendering engine used by the game module"
    },
    "category": {
      "type": "string",
      "enum": [
        "visual-spatial",
        "sequence-recall",
        "category-sorting",
        "drawing-tracing",
        "object-recall"
      ],
      "description": "Primary cognitive memory development domain"
    },
    "difficulty": {
      "type": "object",
      "required": [
        "min",
        "max",
        "default"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1
        },
        "max": {
          "type": "integer",
          "maximum": 10
        },
        "default": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ageRange": {
      "type": "object",
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 2,
          "maximum": 12
        },
        "max": {
          "type": "integer",
          "minimum": 3,
          "maximum": 18
        }
      }
    },
    "assets": {
      "type": "object",
      "properties": {
        "images": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sounds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fonts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "videos": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "settings": {
      "type": "object",
      "properties": {
        "timerEnabled": {
          "type": "boolean"
        },
        "hintsEnabled": {
          "type": "boolean"
        },
        "themes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}