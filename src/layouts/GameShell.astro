---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Fun memory games for kids!' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#8B5CF6" />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <style is:global>
    @import url('https://fonts.googleapis.com/css2?family=Nunito:wght@400;700;900&display=swap');

    * {
      -webkit-tap-highlight-color: transparent;
      touch-action: manipulation;
    }

    body {
      font-family: 'Nunito', sans-serif;
      overflow-x: hidden;
    }

    .perspective-1000 {
      perspective: 1000px;
    }

    .transform-style-preserve-3d {
      transform-style: preserve-3d;
    }

    .backface-hidden {
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
    }

    @keyframes confetti-fall {
      0% { transform: translateY(0) rotate(0deg); opacity: 1; }
      100% { transform: translateY(100vh) rotate(720deg); opacity: 0; }
    }

    .card-hover:hover {
      transform: scale(1.05);
    }

    .matched {
      animation: matched-pulse 0.5s ease-out;
    }

    @keyframes matched-pulse {
      0% { transform: scale(1); }
      50% { transform: scale(1.15); }
      100% { transform: scale(1); }
    }

    /* Accessibility: focus visible */
    button:focus-visible,
    [role="button"]:focus-visible {
      outline: 3px solid #60A5FA;
      outline-offset: 2px;
    }

    /* Prevent text selection during drag */
    .no-select {
      -webkit-user-select: none;
      user-select: none;
    }
  </style>
</head>
<body class="bg-gradient-to-br from-purple-50 via-blue-50 to-pink-50 min-h-screen">
  <slot />
</body>
</html>
